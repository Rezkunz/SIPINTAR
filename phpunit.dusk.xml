<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/dusk-bootstrap.php"
         colors="true"
>
    <testsuites>
        <!-- Hanya file UAT Dusk (TC_xx_xxTest.php); test Feature lain di folder ini tidak ikut -->
        <testsuite name="UAT Modul Pinjaman">
            <directory prefix="TC_" suffix="Test.php">tests/Modul_Pinjaman</directory>
            <exclude>tests/Modul_Pinjaman/iterasi2</exclude>
        </testsuite>
        <!-- Iterasi 2: perbaikan dari feedback UAT Bendahara Bank Mini -->
        <testsuite name="UAT Modul Pinjaman Iterasi 2">
            <directory prefix="TC_" suffix="Test.php">tests/Modul_Pinjaman/iterasi2</directory>
        </testsuite>
        <testsuite name="UAT Modul Dashboard">
            <directory prefix="TC_" suffix="Test.php">tests/Modul_Dashboard/iterasi1</directory>
        </testsuite>
        <!-- Iterasi 2: validasi dashboard & laporan Manajer dari feedback UAT (Tabel IV-35) -->
        <testsuite name="UAT Modul Dashboard Iterasi 2">
            <directory prefix="TC_" suffix="Test.php">tests/Modul_Dashboard/iterasi2</directory>
        </testsuite>
        <testsuite name="UAT Modul Tabungan Iterasi 1">
            <directory prefix="Uc" suffix="Test.php">tests/Modul_Tabungan_Iterasi 1</directory>
        </testsuite>
        <testsuite name="UAT Modul Tabungan Iterasi 2">
            <directory prefix="Uc" suffix="Test.php">tests/Modul_Tabungan_Iterasi_2</directory>
        </testsuite>
    </testsuites>
    <php>
        <!-- Muat .env.uat (database sipintar_dusk) tanpa menukar .env milik aplikasi pengembangan -->
        <!-- $_SERVER dibaca Laravel lebih dulu; `php artisan dusk` mewarisi APP_ENV=local dari .env -->
        <server name="APP_ENV" value="uat" force="true"/>
        <env name="APP_ENV" value="uat" force="true"/>
    </php>
</phpunit>
